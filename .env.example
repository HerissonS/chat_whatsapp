# =============================================================================
# Central de Atendimento WhatsApp - variáveis de ambiente
# Copie para .env com: scripts/init-env.sh  (gera todos os segredos automaticamente)
# Valores __GERAR__ são substituídos por segredos aleatórios fortes pelo init-env.sh.
# NUNCA versione o arquivo .env.
# =============================================================================

# --- Publicação -------------------------------------------------------------
# IP e porta em que o sistema fica acessível (único ponto publicado).
BIND_IP=127.0.0.1
HTTP_PORT=8870
# true quando o acesso for por HTTPS (proxy reverso com TLS na frente).
COOKIE_SECURE=false
# Proxies confiáveis para obter o IP real do usuário (formato do Express). Padrão: só a rede
# interna do Docker. Se houver um proxy reverso na frente (ex.: Nginx Proxy Manager), inclua o IP dele.
TRUST_PROXY=loopback, 172.16.0.0/12

# --- Geral ------------------------------------------------------------------
APP_VERSION=0.1.0
TZ=America/Sao_Paulo
LOG_LEVEL=info
# Dono dos arquivos de backup em ./backups (preenchido pelo init-env.sh).
HOST_UID=1000
HOST_GID=1000

# --- Banco do sistema (MariaDB) ---------------------------------------------
MARIADB_ROOT_PASSWORD=__GERAR__
DB_NAME=chat_whatsapp
DB_USER=chat_app
DB_PASSWORD=__GERAR__

# --- Banco da Evolution (PostgreSQL) ----------------------------------------
EVO_DB_NAME=evolution
EVO_DB_USER=evolution
EVO_DB_PASSWORD=__GERAR__

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=__GERAR__

# --- Evolution API ----------------------------------------------------------
EVOLUTION_API_KEY=__GERAR__
EVOLUTION_INSTANCE=principal
WEBHOOK_TOKEN=__GERAR__

# --- Login e sessões --------------------------------------------------------
SESSION_SECRET=__GERAR__
# Minutos sem uso até a sessão expirar e duração máxima de uma sessão (horas).
SESSION_IDLE_MINUTES=720
SESSION_MAX_HOURS=168
# Bloqueio: após N senhas erradas seguidas, o usuário fica bloqueado por X minutos.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8

# --- E-mail (Gmail com senha de app) ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Nome do remetente. Vazio = usa o nome do sistema definido em Aparência.
SMTP_FROM_NAME=

# --- Mídia e eventos --------------------------------------------------------
MEDIA_MAX_MB=100
# Dias que os eventos brutos do webhook ficam guardados (diagnóstico e reprocessamento).
WEBHOOK_RETENTION_DAYS=30

# --- Catálogo externo (opcional) --------------------------------------------
# Só é usado nos setores com a fonte "Banco externo". Usuário com permissão apenas de SELECT
# nas tabelas contracts e equipament do banco de equipamentos.
CATALOG_DB_HOST=
CATALOG_DB_PORT=3306
CATALOG_DB_NAME=
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=

# --- Backup -----------------------------------------------------------------
BACKUP_TIME=02:30
BACKUP_RETENTION_DAYS=14

# --- Producao com GHCR (usado apenas por docker-compose.prod.yml) -----------
# Preencha com as referencias imutaveis geradas pela pipeline DevSecOps apos
# merge na branch main (ou execute scripts/deploy.sh).
# Exemplo: ghcr.io/<owner>/<repo>-backend:sha-a1b2c3d@sha256:<64_hex_chars>
BACKEND_IMAGE=
FRONTEND_IMAGE=
BACKUP_IMAGE=
